                    "report":  "playwright show-report"
                },
    "devDependencies":  {
                            "@playwright/test":  "^1.55.0",
                            "appium":  "2.19.0",
                            "appium-uiautomator2-driver":  "4.2.9",
                            "dotenv":  "^17.2.1",
                            "webdriverio":  "^9.19.2"
                        }
}
