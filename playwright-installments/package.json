{
    "name":  "travel-house-android-automation",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "setup:android":  "appium driver install uiautomator2",
                    "appium":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-appium.ps1",
