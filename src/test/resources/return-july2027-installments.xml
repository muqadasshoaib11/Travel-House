<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Travel House Installments 1-6 Months Matched Dates" verbose="1" parallel="false">
    <listeners>
        <listener class-name="com.travelhouse.utils.TestListener"/>
    </listeners>

    <!--
      London → Islamabad Return
      For N-month installment (1–6): departure = today + N months.
      Cheapest × each plan through Traveller, then one Fastest (6-month).
      Local run: mvn test -DsuiteXmlFile=src/test/resources/return-july2027-installments.xml
    -->
    <test name="Installments 1-6 Months Cheapest Then Fastest">
        <classes>
            <class name="com.travelhouse.tests.ReturnJuly2027SixInstallmentsSuiteTest"/>
        </classes>
    </test>
</suite>
